{
  "extends": "../tsconfig.base",
  "include": ["**/*.ts"],
  "exclude": ["integration"],
  "references": [{ "path": "../src" }],
  "compilerOptions": {
    // Modules
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "paths": { "src/*": ["../src/*"] },

    // Emit
    "noEmit": true,
    "tsBuildInfoFile": "../dist/tests.tsbuildinfo"
  }
}

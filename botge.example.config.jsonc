{
  // All general boolean switches default to false. Review docs/TERMS.md before enabling providers.
  "general": {
    // Personal 7TV emotes come from the guild's configured set. Added emotes are saved individually.
    "use7TVGlobalEmotes": false,
    "use7TVPersonalEmotes": false,
    "use7TVAddedEmotes": false,
    "useBTTVEmotes": false,
    "useFFZEmotes": false,
    "useTwitchEmotes": false
  },
  "$schema": "botge.config.schema.json"
}

    classDef cloud fill:#122238,stroke:#5aa7ff,color:#e8f2ff,stroke-width:2px,rx:10,ry:10
    classDef base fill:#161b24,stroke:#7d8ba3,color:#e9edf4,stroke-width:2px,rx:10,ry:10

---
title: Botge · Production topology
---
flowchart TB
    subgraph clients["Clients"]
        direction LR
        discordApp(["Discord client"])
        iphone(["Botge iPhone app"])
    end

    subgraph discordCloud["Discord"]
        direction LR
        proxy["Activity proxy<br/>URL mappings"]
        gatewayApi["Gateway, REST,<br/>OAuth and voice"]
    end

    subgraph gcp["Google Cloud"]
        direction LR
        cloudRun["<b>Cloud Run</b><br/>Go Activity origin,<br/>scales to zero"]
        subgraph vm["Compute Engine VM · rootless Docker"]
            direction TB
            funnel["Public HTTPS endpoint<br/>Tailscale Funnel → 127.0.0.1:3080"]
            subgraph compose["Compose project"]
                direction LR
                botge["<b>botge</b><br/>Rust binary and FFmpeg<br/>read-only root, /tmp tmpfs"]
                nginx["<b>nginx</b><br/>7TV media cache"]
            end
            volume[("botge-data volume<br/>botge.redb")]
            cache[("nginx/cache<br/>on the host")]
            control["botge_control<br/>digest deploys over IAP"]
        end
    end

    subgraph external["Upstream services"]
        direction LR
        seventv["<b>7TV</b><br/>7tv.io API and events,<br/>cdn.7tv.app"]
        dockerHub[("Docker Hub<br/>mrewy/botge digests")]
        registry[("Artifact Registry<br/>Activity image digests")]
    end

    discordApp --> proxy
    proxy -->|"/"| cloudRun
    proxy -->|"/botge-api"| funnel
    proxy -->|"/7tv-api, /7tv-cdn"| seventv
    iphone -->|"/app/v1 bearer"| funnel
    funnel --> botge
    botge <-->|gateway and REST| gatewayApi
    botge --> nginx
    nginx --> seventv
    botge -->|catalog and events| seventv
    botge --- volume
    nginx --- cache
    control -.->|compose up by digest| compose
    dockerHub -.->|image| compose
    registry -.->|image| cloudRun


---
title: Botge · Request and data flow
---
flowchart TB
    subgraph commands["Discord commands: /emote-compose or +prefix"]
        direction LR
        user(["User"]) --> gateway["Discord gateway"] --> discord["<b>botge-discord</b><br/>Defer and parse input"]
        discord --> compose["<b>botge-app</b><br/>Resolve names,<br/>hold a render permit"]
        saved[("<b>botge-storage</b><br/>Added emotes, 7TV set,<br/>personal border")] --> compose
        snapshots["<b>botge-emotes</b><br/>Immutable 7TV snapshots"] --> compose
        compose --> render["<b>botge-emotes</b><br/>Download through nginx,<br/>FFmpeg WebP render"]
        render --> reply(["Text or attachment reply"])
    end

    subgraph page["Activity page"]
        direction LR
        launch(["Discord Activity"]) -->|"/"| origin["<b>Go origin</b> on Cloud Run<br/>Verify proxy signature,<br/>serve embedded assets"]
    end

    subgraph settings["Activity settings: voice example"]
        direction LR
        browser(["Activity browser"]) -->|"/botge-api"| ingress["Public HTTPS endpoint<br/>to VM loopback :3080"]
        ingress --> api["<b>botge-activity</b><br/>Verify signature,<br/>decode request"]
        api --> authorize["<b>botge-app</b><br/>Authenticate and authorize"]
        authorize <-->|"identity and guild access"| access["<b>botge-discord</b><br/>GuildAccess"]
        authorize -->|allowed| commit[("<b>botge-storage</b><br/>Commit settings<br/>and catalog revision")]
        commit -->|"notify after commit"| reconcile["<b>botge-voice</b><br/>Reconcile with Discord"]
        authorize -->|denied| reject(["Sanitized error, no write"])
    end


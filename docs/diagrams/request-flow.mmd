%%{init: {"theme":"dark"}}%%
flowchart TB
    subgraph Commands["Discord commands"]
        direction LR
        user["User"] --> gateway["Discord gateway"] --> discord["botge-discord<br/>Slash / prefix commands"]
        discord --> compose["botge-app<br/>Resolve input; hold shared render permit"]
        saved["botge-storage<br/>Guild state and personal border"] --> compose
        snapshots["botge-emotes<br/>Enabled provider snapshots"] --> compose
        compose --> render["botge-emotes<br/>Original download or bounded FFmpeg render"]
        render --> reply["Return through botge-app and botge-discord"] --> attachment["Discord text / attachment"]
    end
    subgraph Settings["Activity voice settings"]
        direction LR
        browser["Activity browser"] --> proxy["Discord proxy<br/>/botge-api"] --> tunnel["API tunnel"]
        tunnel --> api["botge-activity<br/>Proxy signature and request validation"]
        api --> authorize["botge-app<br/>Authenticate and authorize"]
        authorize <-->|current identity and guild access| access["botge-discord<br/>GuildAccess implementation"]
        authorize -->|authorized| commit["botge-storage<br/>Commit voice preference"]
        commit --> notify["Notify AFTER commit"] --> reconcile["botge-voice<br/>Read via app; reconcile with Discord"]
        authorize -->|denied| reject["HTTP error; no write"]
        response["Responses return through botge-app and botge-activity.<br/>Voice reconciliation runs asynchronously after commit."]
    end
    auth["/auth exchanges a one-use code; later requests use a bearer token.<br/>Personal borders use user identity; guild operations check current guild permissions."]
    ui["UI: / maps to the Cloudflare Worker; signed HTML and static assets are served separately.<br/>Provider media uses Discord CDN mappings."]

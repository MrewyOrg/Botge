{
  "theme": "base",
  "fontFamily": "Inter, -apple-system, 'Helvetica Neue', Arial, sans-serif",
  "themeVariables": {
    "darkMode": true,
    "fontFamily": "Inter, -apple-system, 'Helvetica Neue', Arial, sans-serif",
    "fontSize": "15px",
    "background": "#0e1117",
    "primaryColor": "#161b24",
    "primaryBorderColor": "#3b4558",
    "primaryTextColor": "#e9edf4",
    "secondaryColor": "#1b212c",
    "tertiaryColor": "#12161e",
    "textColor": "#c3cbd8",
    "titleColor": "#f5f7fb",
    "lineColor": "#7d8ba3",
    "edgeLabelBackground": "#0e1117",
    "clusterBkg": "#12161e",
    "clusterBorder": "#2b3341",
    "noteBkgColor": "#1b212c",
    "noteBorderColor": "#3b4558",
    "noteTextColor": "#c3cbd8",
    "actorBkg": "#161b24",
    "actorBorder": "#5a6a85",
    "actorTextColor": "#e9edf4",
    "actorLineColor": "#3b4558",
    "signalColor": "#9aa7bd",
    "signalTextColor": "#e9edf4",
    "labelBoxBkgColor": "#1b212c",
    "labelBoxBorderColor": "#3b4558",
    "labelTextColor": "#e9edf4",
    "loopTextColor": "#c3cbd8",
    "activationBkgColor": "#1b212c",
    "activationBorderColor": "#5a6a85",
    "sequenceNumberColor": "#0e1117"
  },
  "flowchart": {
    "curve": "basis",
    "padding": 16,
    "nodeSpacing": 36,
    "rankSpacing": 46,
    "diagramPadding": 28,
    "htmlLabels": true,
    "wrappingWidth": 360
  },
  "sequence": { "mirrorActors": false, "boxMargin": 12, "messageMargin": 34, "actorMargin": 64 },
  "themeCSS": ".flowchartTitleText { font-size: 24px; font-weight: 650; fill: #f5f7fb; letter-spacing: 0.2px; } .cluster-label .nodeLabel, .cluster-label span { font-weight: 600; color: #9aa7bd; } .edgeLabel { color: #c3cbd8; }"
}

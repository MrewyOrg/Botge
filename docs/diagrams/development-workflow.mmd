---
title: Botge · Development and release workflow
---
flowchart TB
    subgraph local["Local development"]
        direction TB
        edit["Edit Rust, TypeScript, Go,<br/>Swift, Python or docs"] --> staged["pre-commit: lint-staged;<br/>build the Activity when its inputs change"]
        staged --> message["commit-msg: Commitlint"] --> pr(["Push dev and open a PR to main"])
    end

    subgraph checks["PR checks"]
        direction LR
        quality["<b>BotgeQL</b><br/>Change-scoped Rust, TypeScript, Go,<br/>iOS, Python, shell and workflow checks<br/>with per-file coverage gates"]
        reuse["Reuse a passing result when<br/>the PR base and inputs are unchanged"]
        codeql["<b>CodeQL</b><br/>Actions, Go, Python,<br/>Rust, TypeScript"]
        deps["<b>Dependency review</b><br/>npm and Cargo audits"]
        reuse -.-> quality
    end

    subgraph release["Release: dev to main"]
        direction TB
        changed{{"Image inputs changed?"}}
        changed -->|Rust| rust["Build AMD64 and ARM64,<br/>scan SBOMs, smoke-test,<br/>publish candidate to Docker Hub"]
        changed -->|Activity| go["Build the Go origin image,<br/>validate SBOM, smoke-test,<br/>retain the tested archive"]
        changed -->|neither| approval
        rust --> approval(["production approval"])
        go --> approval
        approval -->|Rust| vm["Deploy the digest over IAP,<br/>verify gateway and digest,<br/>tag it latest"]
        approval -->|Activity| run["Publish and attest in Artifact Registry,<br/>deploy to Cloud Run,<br/>verify the serving manifest"]
        approval -->|neither| record["Record the current deployment"]
        vm --> merge(["Merge after required checks<br/>and the production deployment"])
        run --> merge
        record --> merge
    end

    pr --> quality & codeql & deps
    quality & deps --> changed
    codeql --> merge
    merge -.-> after["Signed tag, GitHub release and wiki update.<br/>Docker cleanup stays manual."]


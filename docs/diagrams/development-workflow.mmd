flowchart TB
    subgraph local[Local development]
        edit["Edit source, tooling, or docs"] --> staged["pre-commit runs lint-staged<br/>Build the Activity when staged changes affect it"]
        staged --> message["commit-msg runs Commitlint"] --> pr["Push branch and open PR"]
        tools["Language formatters and linters"] -.-> staged
    end
    subgraph checks[PR checks]
        quality["BotgeQL<br/>Change-scoped language, tooling and coverage checks"]
        codeql["CodeQL<br/>Actions, Go, Python, Rust, TypeScript"]
        deps["Dependency review<br/>npm and Cargo security audits"]
    end
    subgraph release[Release from dev to main]
        changed{"Image inputs changed?"}
        changed -->|Rust| rust["Build AMD64 and ARM64<br/>Scan SBOMs and smoke-test images"] --> hub["Publish candidate to Docker Hub"] --> approval
        changed -->|Activity| go["Build AMD64<br/>Validate SBOM and smoke-test image"] --> artifact["Retain tested archive in GitHub Actions"] --> approval
        changed -->|No| approval["Production environment approval"]
        approval -->|Rust changed| vm["Deploy digest through IAP and Compose<br/>Verify gateway and digest"] --> merge
        approval -->|Activity changed| run["Verify archive, publish and attest in Artifact Registry<br/>Deploy and verify Cloud Run revision"] --> merge
        approval -->|No images changed| record["Record the current deployment"] --> merge["Merge after all required checks pass"]
    end
    pr --> quality & codeql & deps
    quality & deps --> changed
    codeql --> merge
    merge -.-> note["Docker cleanup is manual.<br/>Find version notes in GitHub Releases."]

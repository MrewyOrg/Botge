flowchart TB
    bot["<b>botge</b><br/>Executable: configuration, wiring<br/>of every crate, health listener :3081"]

    subgraph adapters["Adapters"]
        direction LR
        discord["<b>botge-discord</b><br/>Gateway events, commands,<br/>OAuth, guild access"]
        activity["<b>botge-activity</b><br/>Axum routes, proxy signatures,<br/>/app/v1 bearer routes"]
        voice["<b>botge-voice</b><br/>Songbird voice and<br/>status reconciliation"]
    end

    app["<b>botge-app</b><br/>Authorization, saved state,<br/>catalog history, Guess rooms,<br/>composition admission"]

    subgraph services["Services"]
        direction LR
        storage[("<b>botge-storage</b><br/>Synchronous redb transactions")]
        emotes["<b>botge-emotes</b><br/>7TV snapshots and events,<br/>bounded FFmpeg rendering"]
    end

    domain["<b>botge-domain</b><br/>Shared records, canonical IDs,<br/>validation, matching rules"]

    bot -. wires .-> adapters
    discord -->|implements GuildAccess| app
    activity --> app
    voice -->|VoiceSettingsSource| app
    app --> storage
    app --> emotes
    storage --> domain
    emotes --> domain

    rule["Adapters never open redb.<br/>Emotes never reads storage.<br/>Discord and Activity stay independent.<br/>tests/architecture.rs enforces these edges."]
    domain ~~~ rule


{
  "extends": "./tsconfig.base",
  "files": [
    "commitlint.config.ts",
    "cspell.config.ts",
    "eslint.config.ts",
    "lint-staged.config.ts",
    "prettier.config.ts",
    "vitest.config.ts"
  ],
  "include": ["tests/control/**/*.ts", "tests/tooling/**/*.ts"],
  "compilerOptions": {
    // Emit
    "noEmit": true,
    // Keep incremental metadata out of the source tree even though JavaScript emit is disabled.
    "tsBuildInfoFile": "./node_modules/.cache/botge/root.tsbuildinfo"
  }
}

# Discord application ID is needed when enabling the Activity API.
APP_ID=$APP_ID
# The bot requests the Server Members privileged intent; enable it in the Developer Portal.
DISCORD_TOKEN=$DISCORD_TOKEN

# Internal liveness/readiness listener on port 3081; never publish this port publicly.
#HEALTH_BIND_HOST=127.0.0.1
# redb directory. The image and Compose use /app/data; keep that path for backup and import.
#BOTGE_DATA_DIR=data
# Register current commands and remove retired ones on startup. The image enables this.
#BOTGE_REGISTER_COMMANDS=true
# Provider-image cache. Compose sets the internal nginx route.
#LOCAL_CACHE_BASE=http://nginx:80
# Deployment tooling persists an approved immutable image here; leave unset for manual latest.
#BOTGE_IMAGE=mrewy/botge@sha256:YOUR_APPROVED_DIGEST

# Prefix commands also require the Message Content intent in the Discord Developer Portal.
#BOTGE_ENABLE_PREFIX_COMPOSE=true

# Set both values to enable the Activity API.
#DISCORD_ACTIVITY_CLIENT_SECRET=$DISCORD_ACTIVITY_CLIENT_SECRET
#DISCORD_ACTIVITY_PUBLIC_KEY=$DISCORD_ACTIVITY_PUBLIC_KEY
# Activity API address on port 3080. Use 0.0.0.0 inside Docker with compose.activity.yaml.
#ACTIVITY_BIND_HOST=127.0.0.1
# Also serve the Activity API to the Botge iOS app under /app/v1, without Discord's proxy
# signature. Requests still need a Discord OAuth token and pass the same membership checks.
#BOTGE_APP_API=true

# Enable /quantum-emote through the CPU-only Q# sidecar; compose.quantum.yaml sets both values.
# The bot still starts when the sidecar is offline; only the command reports it unavailable.
#BOTGE_QUANTUM_URL=http://quantum:3090
# Deployment tooling persists an approved immutable sidecar image here; leave unset for latest.
#BOTGE_QUANTUM_IMAGE=mrewy/botge-quantum@sha256:YOUR_APPROVED_DIGEST
# Optional Bearer secret shared with the sidecar. It requires BOTGE_QUANTUM_URL.
#BOTGE_QUANTUM_SECRET=$BOTGE_QUANTUM_SECRET

# Enable /react-emote through the CPU-only RDKit chemistry sidecar; compose.chemistry.yaml sets both values.
# The bot still starts when the sidecar is offline; only the command reports it unavailable.
#BOTGE_CHEMISTRY_URL=http://chemistry:3091
# Deployment tooling persists an approved immutable sidecar image here; leave unset for latest.
#BOTGE_CHEMISTRY_IMAGE=mrewy/botge-chemistry@sha256:YOUR_APPROVED_DIGEST
# Optional Bearer secret shared with the chemistry sidecar. It requires BOTGE_CHEMISTRY_URL.
#BOTGE_CHEMISTRY_SECRET=$BOTGE_CHEMISTRY_SECRET

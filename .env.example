# Discord application ID is needed when enabling the Activity API.
APP_ID=$APP_ID
DISCORD_TOKEN=$DISCORD_TOKEN

# Prefix commands also require the Message Content intent in the Discord Developer Portal.
#BOTGE_ENABLE_PREFIX_COMPOSE=true

# Set both values to enable the Activity API.
#DISCORD_ACTIVITY_CLIENT_SECRET=$DISCORD_ACTIVITY_CLIENT_SECRET
#DISCORD_ACTIVITY_PUBLIC_KEY=$DISCORD_ACTIVITY_PUBLIC_KEY

# Set both credentials when Twitch global emotes are enabled in the bot config.
#TWITCH_CLIENT_ID=$TWITCH_CLIENT_ID
#TWITCH_SECRET=$TWITCH_SECRET

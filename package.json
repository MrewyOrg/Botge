{
  "name": "botge",
  "version": "5.2.0",
  "private": true,
  "description": "Discord bot and Activity for browsing and composing emotes.",
  "keywords": [
    "bot",
    "discord",
    "discord-bot",
    "emotes"
  ],
  "homepage": "https://github.com/MrewyOrg/Botge#readme",
  "bugs": {
    "url": "https://github.com/MrewyOrg/Botge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrewyOrg/Botge.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Mrewy"
  },
  "license": "MIT",
  "author": "Mrewy",
  "contributors": [
    "gentlebob"
  ],
  "type": "module",
  "workspaces": [
    "activity"
  ],
  "scripts": {
    "check": "npm run check:static && npm test -- --run",
    "check:static": "npm run typecheck && npm run eslint && npm run knip",
    "cspell": "cspell . --verbose",
    "eslint": "eslint \"**/*.ts\" --flag unstable_native_nodejs_ts_config --concurrency=auto",
    "knip": "knip --no-progress",
    "lint:shell": "bash scripts/lint-shell.sh",
    "lint:workflows": "sh scripts/lint-workflows.sh",
    "markdownlint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "prepare": "sh .husky/install.sh",
    "start": "docker image prune --force && docker compose -f compose.yaml -f compose.build.yaml up --build",
    "stop": "docker compose stop",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build && npm run typecheck -w activity"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": true
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/format": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.1.0-beta",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "prettier-plugin-nginx": "^2.0.0",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-toml": "^4.1.0",
    "ts-essentials": "^10.2.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  }
}

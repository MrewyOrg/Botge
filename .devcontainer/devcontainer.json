// cspell:words moby tamasfe trixie vadimcn

// See https://aka.ms/devcontainer.json for the configuration format.

{
  "name": "Botge",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker": {
      "moby": false,
      "installDockerBuildx": true,
      "azureDnsAutoDetection": false,
      "installDockerComposeSwitch": false
    },
    "ghcr.io/devcontainers/features/github-cli": { "extensions": "github/gh-actions-lock" },
    // Use the minimal bootstrap toolchain. The workspace selects its own nightly and components.
    "ghcr.io/devcontainers/features/rust": { "components": "none" },
    // Install nvm here. Setup reads the Node version from the mounted workspace's .nvmrc.
    "ghcr.io/devcontainers/features/node": {
      "version": "none",
      "npmVersion": "none",
      "pnpmVersion": "none",
      "nodeGypDependencies": false
    }
  },

  "postCreateCommand": "bash scripts/setup-devcontainer.sh",

  "customizations": {
    "codespaces": { "openFiles": ["README.md", "Cargo.toml", "src/main.rs"] },
    "vscode": {
      "extensions": [
        // Development environment
        "actboy168.tasks",
        "docker.docker",

        // Languages and configuration
        "ahmadalli.vscode-nginx-conf",
        "dotenv.dotenv-vscode",
        "redhat.vscode-yaml",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "tsandall.opa",
        "TypeScriptTeam.native-preview",
        "xlaoyu.npmrc-helper",

        // Native debugging
        "vadimcn.vscode-lldb",

        // Formatting and validation
        "DavidAnson.vscode-markdownlint",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "joshbolduc.commitlint",
        "streetsidesoftware.code-spell-checker",

        // Git and GitHub
        "eamodio.gitlens",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",

        // Security analysis
        "GitHub.vscode-codeql",
        "MS-SarifVSCode.sarif-viewer",

        // Appearance
        "aaron-bond.better-comments",
        "vscode-icons-team.vscode-icons"
      ]
    }
  }
}

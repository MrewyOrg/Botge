{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      // Startup is discovered through package.json's main field and source mapping.
      // Keep the dormant Reddit factory as an additional entry point.
      "entry": ["src/api/reddit/new-reddit-api.ts"],
      "ignore": ["tests/integration/**"]
    },
    "activity": { "entry": ["worker/entry.ts"] }
  },
  // Supplied by the container/host, rather than npm.
  "ignoreBinaries": ["actionlint", "ffmpeg", "ffprobe", "shellcheck"]
}

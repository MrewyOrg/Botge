* text=auto eol=lf

*.bash diff=bash
*.go diff=golang
*.html diff=html
*.md diff=markdown
*.py diff=python
*.rs diff=rust
*.scss diff=css
*.sh diff=bash
*.tex diff=tex

*.pdf binary
*.png binary
*.webp binary

# Suppress line diffs for VS Code icons while preserving text normalization.
assets/vsicons-custom-icons/*.svg -diff

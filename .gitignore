# Host deployment state and atomic temporary files.
.botge-image*
# Full reference snapshots are an optional local cache; compact indexes and manifest stay tracked.
/.agents/references/cache/
.venv/
.ruff_cache/
**/__pycache__/
# Lake build output and fetched Mathlib packages for quantum/proofs/lean.
**/.lake/
# iOS: the Xcode project is generated from ios/project.yml; tools and builds are local.
/ios/*.xcodeproj/
/ios/Config/*.local.xcconfig
/ios/Tools/.build/
/ios/Tools/bin/
DerivedData/
xcuserdata/
*.xcuserstate

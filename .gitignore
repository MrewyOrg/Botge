.DS_Store
/.claude/
/.codex
/.serena/
/.github/codeql/database/*
!/.github/codeql/database/.gitkeep
/.github/codeql/output/*
!/.github/codeql/output/.gitkeep
/data
/activity/dist/
/activity/server/internal/site/dist*/
/activity/server/internal/site/.stage.lock/
/nginx/cache
node_modules/
/tmp

/.env
/botge.config.json

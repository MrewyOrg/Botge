// cspell:words botgeql tamasfe vsicons

{
  // Editor
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.detectIndentation": false,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.insertSpaces": true,
  "editor.smoothScrolling": true,
  "editor.tabSize": 2,

  // Files
  "files.associations": {
    ".dockerignore": "ignore",
    "*.service": "ini",
    "*.socket": "ini",
    "**/.husky/commit-msg": "shellscript",
    "**/.husky/post-merge": "shellscript",
    "**/.husky/pre-commit": "shellscript",
    "botge.config.json": "jsonc",
    "Dockerfile.rego": "rego"
  },
  "files.autoSave": "onFocusChange",
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  // Generated files, dependency contents, and runtime output stay read-only in the editor.
  "files.readonlyInclude": {
    ".devcontainer/devcontainer-lock.json": true,
    ".github/codeql/database/**/*": true,
    ".github/codeql/output/**/*": true,
    ".github/workflows/actions.lock": true,
    ".husky/_/**/*": true,
    "**/*.tsbuildinfo": true,
    "Cargo.lock": true,
    "coverage/**/*": true,
    "data/**/*": true,
    "**/dist/**": true,
    "nginx/cache/**/*": true,
    "node_modules/**/*": true,
    "package-lock.json": true,
    "target/**/*": true,
    "tmp/**/*": true
  },
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  // Avoid watching generated files and runtime data; retain VS Code’s default exclusions.
  "files.watcherExclude": {
    "**/.github/codeql/database/**": true,
    "**/.github/codeql/output/**": true,
    "**/.husky/_/**": true,
    "**/.wrangler/**": true,
    "**/*.tsbuildinfo": true,
    "**/coverage/**": true,
    "**/data/**": true,
    "**/dist/**": true,
    "**/nginx/cache/**": true,
    "**/target/**": true,
    "**/tmp/**": true
  },

  // Search
  "search.exclude": {
    "**/.github/codeql/database/**": true,
    "**/.github/codeql/output/**": true,
    "**/.husky/_/**": true,
    "**/.wrangler/**": true,
    "**/*.tsbuildinfo": true,
    "**/coverage/**": true,
    "**/data/**": true,
    "**/dist/**": true,
    "**/nginx/cache/**": true,
    "**/target/**": true,
    "**/tmp/**": true
  },
  "search.useIgnoreFiles": true,

  // Diff editor
  "diffEditor.ignoreTrimWhitespace": false,

  // Workbench
  "workbench.iconTheme": "vscode-icons",
  "workbench.list.smoothScrolling": true,
  "workbench.startupEditor": "none",

  // Source control
  "scm.graph.badges": "all",
  "scm.repositories.explorer": true,
  "scm.repositories.selectionMode": "single",
  "scm.showInputActionButton": false,

  // Git
  "git.alwaysSignOff": false,
  "git.autofetch": true,
  "git.enableCommitSigning": true,

  // Terminal
  "terminal.integrated.enableImages": false,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.gpuAcceleration": "auto",
  "terminal.integrated.initialHint": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.suggest.insertTrailingSpace": false,
  "terminal.integrated.suggest.quickSuggestions": {
    "arguments": "on",
    "commands": "on",
    "unknown": "off"
  },
  "terminal.integrated.suggest.showStatusBar": true,
  "terminal.integrated.tabs.showActions": "singleTerminalOrNarrow",
  "terminal.integrated.tabs.showActiveTerminal": "always",
  "terminal.integrated.tabs.title": "botge${separator}${process}",

  // Rust
  "rust-analyzer.check.allTargets": true,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--locked"],

  // TypeScript
  "js/ts.experimental.useTsgo": true,
  "js/ts.format.enabled": false,
  "js/ts.implicitProjectConfig.module": "NodeNext",
  "js/ts.implicitProjectConfig.target": "ESNext",
  // Avoid recursive scanning of packages that do not declare exports.
  "js/ts.preferences.autoImportEntrypointDirectorySearch": false,
  "js/ts.preferences.autoImportFileExcludePatterns": [
    "**/coverage/**",
    "**/data/**",
    "**/dist/**",
    "**/nginx/cache/**"
  ],
  // The “js” option includes .ts extensions when rewriteRelativeImportExtensions is enabled.
  "js/ts.preferences.importModuleSpecifierEnding": "js",
  "js/ts.preferences.organizeImports": {
    "caseSensitivity": "caseInsensitive",
    "typeOrder": "inline"
  },
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.trace.server": "off",
  "js/ts.tsdk.path": "./node_modules/@typescript/native",
  "js/ts.updateImportsOnFileMove.enabled": "always",

  // npm
  "npm.packageManager": "npm",
  "npm.scriptRunner": "npm",

  // Prettier
  "prettier.configPath": "prettier.config.ts",
  // Docker and GitHub Actions use custom language IDs for YAML files.
  "prettier.documentSelectors": ["**/compose*.{yml,yaml}", "**/.github/workflows/*.{yml,yaml}"],
  "prettier.ignorePath": ".prettierignore",
  "prettier.requireConfig": true,

  // ESLint
  // Inline ESLint configuration is disabled in eslint.config.ts.
  "eslint.codeAction.disableRuleComment": { "enable": false },
  "eslint.format.enable": false,
  "eslint.options": { "flags": ["unstable_native_nodejs_ts_config"] },
  "eslint.run": "onSave",
  "eslint.runtime": "node",
  "eslint.validate": ["typescript"],
  "eslint.workingDirectories": ["."],

  // Markdownlint
  "markdownlint.configFile": ".markdownlint-cli2.jsonc",
  "markdownlint.run": "onSave",

  // Spell checking
  "cSpell.mergeCSpellSettings": false,

  // Commitlint
  "commitlint.config.file": "commitlint.config.ts",
  "commitlint.preferBundledLibraries": false,

  // JSON schemas
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  },

  // YAML
  "redhat.telemetry.enabled": false,
  "yaml.format.enable": false,
  "yaml.kubernetesCRDStore.enable": false,

  // OPA / Rego
  // Dockerfile.rego is a standalone policy; the workspace is not an OPA data bundle.
  "opa.bundleMode": false,
  "opa.checkOnSave": true,
  "opa.formatter": "opa-fmt",
  "opa.strictMode": true,

  // Docker
  "docker.lsp.telemetry": "off",

  // GitHub
  "github-actions.workflows.pinned.workflows": [
    ".github/workflows/botgeql.yml",
    ".github/workflows/build-and-deploy.yml"
  ],
  // Keep the long-lived dev/main branches when finishing a pull request.
  "githubPullRequests.defaultDeletionMethod.selectLocalBranch": false,
  "githubPullRequests.defaultDeletionMethod.selectRemote": false,

  // GitLens
  "gitlens.ai.enabled": false,
  "gitlens.plusFeatures.enabled": false,
  "gitlens.telemetry.enabled": false,
  "gitlens.virtualRepositories.enabled": false,

  // CodeQL
  "codeQL.githubDatabase.download": "never",

  // SARIF viewer
  "sarif-viewer.connectToGithubCodeScanning": "off",

  // File icons
  "vsicons.associations.files": [
    {
      "extensions": ["botge.config.json", "botge.example.config.jsonc"],
      "filename": true,
      "format": "png",
      "icon": "botge"
    }
  ],
  "vsicons.associations.folders": [
    { "extensions": ["discord"], "format": "svg", "icon": "discord" }
  ],
  "vsicons.customIconFolderPath": "assets",

  // Privacy and chat
  "chat.disableAIFeatures": false,
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,

  // Language overrides
  "[dockerfile][dotenv][ini][npmrc]": {
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.trimTrailingWhitespace": false
  },
  "[nginx]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[rego]": {
    "editor.defaultFormatter": "tsandall.opa",
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
  "[toml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  // Fix on explicit save; preserve import groups and intentional side-effect imports.
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "never"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml][dockercompose][github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}

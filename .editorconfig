root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.rego]
indent_style = tab
indent_size = 4

[*.py]
indent_size = 4

# SwiftFormat follows the repository's two-space, 100-column style; see ios/.swiftformat.
[*.swift]
indent_size = 2
max_line_length = 100

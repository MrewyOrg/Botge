{
  "name": "botge-activity",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-11-10",
  // The Worker owns HTML routing. public/.assetsignore excludes index.html from static serving.
  "assets": { "directory": "./dist", "html_handling": "none" },
  // Keep DISCORD_ACTIVITY_PUBLIC_KEY when it was set in the dashboard and a deploy omits --var.
  "keep_vars": true,
  // Discord maps the Activity to the Worker's own URL; per-version preview URLs are not used.
  "preview_urls": false
}

{
  "name": "@botge/activity",
  "private": true,
  "description": "Discord Activity for browsing, composing, and managing Botge emotes and settings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrewyOrg/Botge.git",
    "directory": "activity"
  },
  "homepage": "https://github.com/MrewyOrg/Botge/wiki/Activity",
  "bugs": {
    "url": "https://github.com/MrewyOrg/Botge/issues"
  },
  "type": "module",
  "scripts": {
    "build": "vite build --base=./ --target=esnext",
    "check:markup": "npm run build && html-validate --preset standard --max-warnings 0 index.html dist/index.html",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "html-validate": "^11.21.1",
    "jsdom": "^31.0.0",
    "sass": "^1.108.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.20.0"
  }
}
